# 选择 LLM 提供方：openai 或 ollama
POLICYHUB_LLM_PROVIDER=ollama

# Ollama（当 POLICYHUB_LLM_PROVIDER=ollama 时使用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Ollama 超时/保活：避免冷启动或长回答触发 ReadTimeout
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_KEEP_ALIVE=5m

# DeepSeek（当 POLICYHUB_LLM_PROVIDER=deepseek 时使用，OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-743f86583b1941e69f49d6f5981781d3
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型（默认 bge-m3；首次下载较大）
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Embedding 计算设备：auto | cuda | cpu
# - auto：若检测到 CUDA 则用 GPU，否则用 CPU
EMBEDDING_DEVICE=auto

# Chroma 持久化目录
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=green_policyhub

# 原始政策文本目录
RAW_DOCS_DIR=./data/raw

# 索引缓存目录（用于存放 LlamaIndex 的 docstore 等）
INDEX_DIR=./data/index
